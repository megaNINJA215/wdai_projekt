generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  username              String                  @unique
  password_hash         String
  salt                  String
  active_sessions       active_sessions[]
  comments              comments[]
  communities           communities[]
  community_memberships community_memberships[]
  posts                 posts[]
  saved_posts           saved_posts[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model active_sessions {
  session_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  users      users  @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "active_sessions_userID_fkey")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model communities {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  owner_id              String                  @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String                  @unique
  description           String?
  users                 users                   @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  community_memberships community_memberships[]
  posts                 posts[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model posts {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  author_id    String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  community_id String?       @db.Uuid
  title        String
  content      String
  edited_at    DateTime?     @db.Timestamptz(6)
  short_id     String        @unique
  comments     comments[]
  users        users         @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  communities  communities?  @relation(fields: [community_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  saved_posts  saved_posts[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model community_memberships {
  user_id      String      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  joined_at    DateTime    @default(now()) @db.Timestamptz(6)
  community_id String      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communities  communities @relation(fields: [community_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, community_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model saved_posts {
  user_id  String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saved_at DateTime @default(now()) @db.Timestamptz(6)
  post_id  String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  posts    posts    @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users    users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, post_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model comments {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at        DateTime   @default(now()) @db.Timestamptz(6)
  author_id         String     @db.Uuid
  post_id           String     @db.Uuid
  parent_comment_id String?    @db.Uuid
  content           String
  users             users      @relation(fields: [author_id], references: [id], onUpdate: NoAction)
  comments          comments?  @relation("commentsTocomments", fields: [parent_comment_id, post_id], references: [id, post_id], onDelete: Cascade, onUpdate: NoAction, map: "comments_parent_same_post_fkey")
  other_comments    comments[] @relation("commentsTocomments")
  posts             posts      @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id, post_id], map: "comments_id_post_id_unique")
}
